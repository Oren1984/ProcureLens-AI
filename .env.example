# Copy to .env (never commit .env). `scripts/init-env.sh` generates one with random secrets.

# --- Database (secrets: generate long random values) ---
POSTGRES_DB=procurelens
POSTGRES_USER=procurelens_owner
POSTGRES_PASSWORD=__generate_a_random_value__
APP_DB_USER=procurelens_app
APP_DB_PASSWORD=__generate_a_random_value__

# --- Private directory OUTSIDE the repository for the bootstrap credentials file ---
# Windows example: C:/Users/<you>/.procurelens/private   Linux/macOS: /home/<you>/.procurelens/private
PROCURELENS_PRIVATE_DIR=__absolute_path_outside_repo__

# --- Business configuration ---
PROCURELENS_BASE_CURRENCY=EUR
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8

# --- Optional: real ERPNext (read-only integration user) ---
ERPNEXT_BASE_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
# Optional lower bound for document dates, e.g. 2026-01-01
ERPNEXT_SYNC_FROM=

# --- Optional: local AI via the `ai` Compose profile ---
# OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:3b
# CPU-only generation measured at ~80-110 s per explanation with qwen2.5:3b.
OLLAMA_TIMEOUT_SECONDS=150

LOG_LEVEL=INFO
