# syntax=docker/dockerfile:1.7
# ProcureLens AI application image (Streamlit UI + operator CLI). Runs as a non-root user.
FROM python:3.12-slim-trixie

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    EMBEDDING_MODEL=BAAI/bge-small-en-v1.5 \
    EMBEDDING_CACHE_DIR=/opt/models

WORKDIR /app

# Hash-locked dependencies (requirements.lock is generated by `uv pip compile --generate-hashes`).
# An optional build secret `build_ca` supplies a CA bundle for build-time downloads only, for
# networks with TLS inspection. It is mounted for single RUN steps and never stored in a layer.
COPY requirements.lock .
RUN --mount=type=secret,id=build_ca,required=false \
    if [ -s /run/secrets/build_ca ]; then export PIP_CERT=/run/secrets/build_ca; fi; \
    pip install --no-deps --require-hashes -r requirements.lock

# Download the pinned embedding model once at build time (~67 MB from Hugging Face:
# qdrant/bge-small-en-v1.5-onnx-q via fastembed 0.7.4). The runtime then works offline.
RUN --mount=type=secret,id=build_ca,required=false \
    if [ -s /run/secrets/build_ca ]; then export SSL_CERT_FILE=/run/secrets/build_ca; fi; \
    HF_HUB_DISABLE_TELEMETRY=1 python -c "from fastembed import TextEmbedding; \
TextEmbedding('${EMBEDDING_MODEL}', cache_dir='${EMBEDDING_CACHE_DIR}')" \
    && chmod -R a+rX /opt/models

RUN groupadd --system --gid 10001 app \
    && useradd --system --uid 10001 --gid app --home-dir /tmp --shell /usr/sbin/nologin app

COPY --chown=root:root alembic.ini ./
COPY --chown=root:root migrations ./migrations
COPY --chown=root:root src ./src
COPY --chown=root:root knowledge ./knowledge
COPY --chown=root:root docs/help ./docs/help
COPY --chown=root:root .streamlit ./.streamlit

ENV PYTHONPATH=/app/src \
    HOME=/tmp \
    HF_HUB_OFFLINE=1 \
    PROCURELENS_KNOWLEDGE_DIR=/app/knowledge \
    PROCURELENS_HELP_DIR=/app/docs/help

USER 10001:10001
EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8501/_stcore/health', timeout=4).status == 200 else 1)"

CMD ["streamlit", "run", "src/procurelens/ui/app.py"]
